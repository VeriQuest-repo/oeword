{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oeword",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // 정적 파일(React 화면)과 /api/* 를 한 Worker에서 처리합니다.
  // /api/* 는 Worker가 먼저 받고, 나머지 주소는 화면(index.html)으로 보냅니다.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oeword",
      // `npx wrangler d1 create oeword` 로 만든 배포용 D1 (APAC).
      // 로컬 개발(npm run dev)은 이 값과 상관없이 로컬 D1을 씁니다.
      "database_id": "464c8d30-2fa8-4e37-8c40-6fdd52052730",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
